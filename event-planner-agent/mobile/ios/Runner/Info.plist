	<string>Take a photo of a receipt so the group can see proof of each expense.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock Wargakas so only you can see your group's money records.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach an existing receipt photo to an expense.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.wargakas.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>io.wargakas.mobile</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>whatsapp</string>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string><string>id</string><string>ms</string><string>es</string>
		<string>pt</string><string>fr</string><string>de</string><string>vi</string>
		<string>th</string><string>hi</string><string>ar</string><string>zh</string>
		<string>ja</string>
	</array>
